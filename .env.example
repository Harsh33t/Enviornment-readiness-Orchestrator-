# ==============================================================================
# Environment Readiness Prototype - Local Configuration Template
# ==============================================================================
# NOTE: This prototype operates exclusively against local, deterministic mock services.
# It does NOT require any paid services, third-party API keys, or external credentials.
# DO NOT place real production secrets or customer credentials here.
# ==============================================================================

# Application Port
VITE_APP_PORT=3000

# Mock Environment Base URL (Deterministic in-memory mock handler)
VITE_MOCK_ENV_BASE_URL=http://localhost:3000/mock-env

# Feature Flags
VITE_ENABLE_MOCK_FIXTURES=true
VITE_DEMO_MODE=true
